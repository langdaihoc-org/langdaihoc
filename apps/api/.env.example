# API
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
# COOKIE_SAMESITE=none
# CORS_ORIGINS=
# TRUST_PROXY=1

# Supabase (local — `supabase status` sau `supabase start`)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 — ảnh public (food/laundry/post/banner). Bỏ trống = fallback Supabase.
# payment-proofs luôn dùng Supabase (private signed URL).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=langdaihoc-media
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# PostgreSQL (Drizzle)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
