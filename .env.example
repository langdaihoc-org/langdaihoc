# Copy to apps/api/.env and apps/web/.env as needed

# Web (apps/web/.env)
VITE_API_URL=
# Realtime + Google OAuth: VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY

# API (apps/api/.env)
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://langdaihoc.xyz
# Cookie secure: bật true khi chạy sau HTTPS (khuyến nghị production).
COOKIE_SECURE=false
# Cross-origin (Vercel web + Railway API): COOKIE_SAMESITE=none + COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# CORS: thêm origin web (Vercel). Nhiều origin cách nhau bằng dấu phẩy.
# CORS_ORIGINS=https://xxx.vercel.app
# TRUST_PROXY=1 khi đứng sau Railway/proxy
# Production bắt buộc: FRONTEND_URL, DATABASE_URL, SUPABASE_* (API không fallback localhost).

# Ports khớp supabase/config.toml (Windows Hyper-V tránh 54321)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (optional local / bắt buộc production khuyến nghị) — ảnh public
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=langdaihoc-media
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# After `supabase start`, copy keys from: supabase status
# Studio: http://127.0.0.1:55323
